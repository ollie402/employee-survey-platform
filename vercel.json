{
  "version": 2,
  "functions": {
    "api/*.js": {
      "maxDuration": 10
    }
  },
  "rewrites": [
    {
      "source": "/chat/:slug",
      "destination": "/chat.html"
    },
    {
      "source": "/survey/:id",
      "destination": "/survey.html"
    },
    {
      "source": "/setup",
      "destination": "/setup.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
